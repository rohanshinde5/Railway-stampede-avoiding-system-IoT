# -----------------------------------------------------------------------------
# .env.example – Railway Crowd Management System
#
# This file is DOCUMENTATION ONLY for the backend / deployment configuration.
# It does NOT configure the ESP32 firmware (that is done in src/config.h).
# Copy this to .env and fill in your real values. NEVER commit .env.
# -----------------------------------------------------------------------------

# -- MQTT Broker ---------------------------------------------------------------
# Development: test.mosquitto.org (unauthenticated, public)
# Production:  your HiveMQ Cloud / private broker hostname
MQTT_BROKER=test.mosquitto.org
MQTT_PORT=1883

# MQTT credentials (leave blank for test.mosquitto.org)
MQTT_USERNAME=
MQTT_PASSWORD=

# -- Device --------------------------------------------------------------------
DEVICE_ID=ESP32-RAILSAFE-01

# -- Backend / API Server ------------------------------------------------------
PORT=4000
NODE_ENV=development

# -- Database ------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/railway-crowd

# -- Security ------------------------------------------------------------------
# IMPORTANT: Replace with a long random secret before deployment.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# -- MQTT Topic Namespace ------------------------------------------------------
# Topics follow the pattern: railway/railsafe/<DEVICE_ID>/<subtopic>
# Example topics:
#   railway/railsafe/ESP32-RAILSAFE-01/crowd/state
#   railway/railsafe/ESP32-RAILSAFE-01/crowd/event
#   railway/railsafe/ESP32-RAILSAFE-01/system/heartbeat
#   railway/railsafe/ESP32-RAILSAFE-01/system/command
#   railway/railsafe/ESP32-RAILSAFE-01/control/emergency
#   railway/railsafe/ESP32-RAILSAFE-01/control/reset
